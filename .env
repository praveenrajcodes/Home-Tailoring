# Copy this file to .env for local development.
# On Render, these are set as Environment Variables instead (see README.md).

# Local Postgres connection string. Render provides this automatically
# when you attach a database to the web service via render.yaml.
DATABASE_URL=postgresql://neondb_owner:npg_Jqk1wuXdtjO5@ep-lucky-pond-b56v3uo5-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Set to "false" only for a local Postgres that isn't using SSL.
# Leave unset (or "true") for Render / any hosted Postgres.
DB_SSL=true

# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

PORT=4000
